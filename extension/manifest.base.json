{
  "manifest_version": 3,
  "name": "Browsteer",
  "version": "0.0.0",
  "description": "Lets Claude Code on this computer read pages, click, and fill forms in this browser, only on sites you allow.",
  "icons": { "16": "icons/16.png", "32": "icons/32.png", "48": "icons/48.png", "128": "icons/128.png" },
  "permissions": ["tabs", "storage", "alarms", "webRequest"],
  "host_permissions": ["<all_urls>"],
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'self'; connect-src ws://127.0.0.1:8787 https://*:* http://*:*"
  },
  "action": {
    "default_title": "Browsteer",
    "default_popup": "popup.html",
    "default_icon": { "16": "icons/16.png", "32": "icons/32.png", "48": "icons/48.png" }
  },
  "options_ui": { "page": "options.html", "open_in_tab": true },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"],
      "run_at": "document_idle",
      "all_frames": false
    }
  ]
}

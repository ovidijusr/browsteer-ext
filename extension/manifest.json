{
  "manifest_version": 3,
  "name": "Browsteer",
  "version": "1.0.0",
  "description": "Pair this browser with a local Claude Code instance and drive it via a token-efficient accessibility snapshot.",
  "icons": { "48": "icon.svg", "96": "icon.svg", "128": "icon.svg" },
  "permissions": ["tabs", "activeTab", "scripting", "storage", "alarms"],
  "host_permissions": ["<all_urls>"],
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'self'; connect-src 'self' ws://127.0.0.1:8787 ws://localhost:8787 http://127.0.0.1:8787"
  },
  "action": {
    "default_title": "Browsteer",
    "default_popup": "popup.html",
    "default_icon": "icon.svg"
  },
  "background": {
    "scripts": ["dist/background.js"]
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["dist/content.js"],
      "run_at": "document_idle",
      "all_frames": false
    }
  ],
  "browser_specific_settings": {
    "gecko": {
      "id": "browsteer-cc@ovi.lt",
      "strict_min_version": "128.0",
      "data_collection_permissions": { "required": ["none"] }
    }
  }
}

{
  "name": "browsteer",
  "version": "2.1.0",
  "private": true,
  "license": "MIT",
  "type": "module",
  "scripts": {
    "setup": "bun run scripts/setup.ts",
    "dev": "bun run scripts/dev.ts",
    "build": "bun run scripts/build.ts",
    "build:firefox": "bun run scripts/build.ts firefox",
    "build:chrome": "bun run scripts/build.ts chrome",
    "typecheck": "tsc --noEmit -p extension && tsc --noEmit",
    "test": "bun test",
    "test:e2e": "bun run test/e2e/run.ts",
    "reduction": "bun run test/reduction.ts",
    "bench:targeting": "bun run test/bench-targeting.ts",
    "mcp": "bun run bridge/mcp.ts",
    "hub": "bun run bridge/hub.ts",
    "hub:stop": "bun run bridge/hub.ts --stop",
    "lint:firefox": "bun run build:firefox && web-ext lint --source-dir dist/firefox",
    "package": "bun run scripts/package.ts",
    "sign:firefox": "bun run build:firefox && web-ext sign --source-dir dist/firefox --artifacts-dir artifacts --channel unlisted",
    "updates-json": "bun run scripts/updates-json.ts",
    "update": "bun run scripts/update.ts"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.29.0",
    "@typesafe-ai/sdk": "0.6.0",
    "zod": "3.25.76"
  },
  "devDependencies": {
    "@types/bun": "1.3.14",
    "@types/firefox-webext-browser": "143.0.0",
    "happy-dom": "20.11.1",
    "playwright": "1.64.1",
    "typescript": "7.0.2",
    "web-ext": "8.10.0"
  }
}
